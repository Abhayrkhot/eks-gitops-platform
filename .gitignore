# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
crash.log
.terraform.tfstate.lock.info
# generated per-account backend config (holds the account id)
terraform/live/*/backend-*.hcl
# local scratch
.work/
*.pyc
__pycache__/
.venv/

# module-level lock files are generated by validate; only root stacks pin providers
terraform/modules/**/.terraform.lock.hcl
terraform/live/backend-*.hcl
